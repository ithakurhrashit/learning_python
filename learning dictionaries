info = {
    '1.':'HARSHIT',
    '2.':'ANSHUL',
    '3.':'RAHUL'
}
print(info)
print(info['1.'])
print(info.get('2.'))
print(info.get('3.'))  
print(info.keys())
print(info.values())
for key in info.keys():
    print(f"the value corresponding to the key {key} is {info[key]}")
#this will print both the key as well as value
print(info.items())
#or you can use the below method to print the key and values 
for key,value in info.items():
    print(f"the value to the key {key} is {value}")
