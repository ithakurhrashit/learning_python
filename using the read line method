f=open('marks.txt','r')
i=0
while True:
    i=i+1
    lines=f.readlines()
    if not lines:
        break
    m1=lines.split(",")[0]
    m2=lines.split(",")[1]
    m3=lines.split(",")[2]
    print(f"marks of student {i} in maths is {m1}")
    print(f"marks of student {i}in sst is {m2}")
    print(f"marks of student {i} in science is {m3}")
    print(lines)

    
